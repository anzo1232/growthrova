[Unit]
Description=Growthrova integrated homepage and workspace
After=network.target growthrova-api.service
Requires=growthrova-api.service

[Service]
Type=simple
User=growthrova
Group=growthrova
WorkingDirectory=/home/growthrova/app/frontend
Environment=NODE_ENV=production
Environment=GROWTHROVA_BACKEND_ORIGIN=http://127.0.0.1:4190
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 4195
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
